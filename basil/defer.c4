#include <stdio.h>
#include <stdlib.h>

int execution_tracker = 0;

verify_order (int expected_step, const char *label) {
    execution_tracker++;
    printf("[Step %d] Executing: %s\n", execution_tracker, label);
    if (execution_tracker != expected_step) {
        printf("Test Failed: %s executed at step %d, expected step %d!\n",
               label, execution_tracker, expected_step);
        exit(1);
    }
}

main () int {
    printf("Starting Defer Sigil Verification...\n");

    {
        // 1. Single line defer declaration
        ->} verify_order(3, "First Defer (Single Line)"); // Declared first, should run LAST

        printf("[Step 1] Processing primary block body payload...\n");
        verify_order(1, "Main Body Execution");

        // 2. Multi-line compound block defer declaration
        ->} {
            verify_order(2, "Second Defer (Compound Block - Part 1)");
            int structural_math = 40 + 2;
            printf("         Inline block math check: %d\n", structural_math);
        } // Declared second, should run FIRST

        printf("[Step 2] Exiting inner scope boundary layer...\n");
    } // <--- BOTH DEFER STATEMENTS MUST TRIGGER UNWINDING HERE

    if (execution_tracker != 3) {
        printf("Test Failed: Defer blocks did not completely unwind before scope exit!\n");
        return 1;
    }

    printf("\nAll Custom '->}' Defer Integration Tests Passed Successfully!\n");
    return 0;
}
