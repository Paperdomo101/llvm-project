#include <stdio.h>

typedef struct { float x, y, z; } Vector3;

Clamp(Vector3 v, float min, float max) Vector3 {
    if (v.x < min) v.x = min;
    if (v.x > max) v.x = max;
    if (v.y < min) v.y = min;
    if (v.y > max) v.y = max;
    if (v.z < min) v.z = min;
    if (v.z > max) v.z = max;
    return v;
}

get_counter() int {
    static frame_counter := 0;
    frame_counter = frame_counter + 1;
    return frame_counter;
}

main() int {
    // 1. Test position + {0, 1, 0} struct arith without cast
    Vector3 position = {1.0, 2.0, 3.0};
    Vector3 next_pos = position + {0.0, 1.5, -1.0};
    "{%g, %g, %g}\n"::printf(next_pos.{x, y, z})

    // 2. Test ::= operator
    Vector3 tick_t = { 0.5, 2.0, -1.0 };
    tick_t ::= Clamp(0.0, 1.0);
    "{%g, %g, %g}\n"::printf(tick_t.{x, y, z})

    // 3. Test top.{x, y, z} = position.{x, y + 1, z} (expressions in swizzle)
    Vector3 top;
    top.{x, y, z} = position.{x, y + 1.25, z - 0.5};
    "{%g, %g, %g}\n"::printf(top.{x, y, z})

    // 4. Test static frame_counter := 0
    "counter = %d\n"::printf(get_counter())
    "counter = %d\n"::printf(get_counter())
    "counter = %d\n"::printf(get_counter())

    return 0;
}
