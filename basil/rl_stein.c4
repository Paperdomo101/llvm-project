#include "raylib.h"
#include "raymath.h"

const ANIMATION_SPEED := (0.1f) // Animation frame interval (seconds)
const PLAYER_SPEED := (20.0f)   // Player movement speed (pixels/second)
// Initial window size
const INIT_SCREEN_WIDTH  := (800)
const INIT_SCREEN_HEIGHT := (450)

main () int {
    // Allow window resizing
    SetConfigFlags(FLAG_WINDOW_RESIZABLE)
    InitWindow(INIT_SCREEN_WIDTH, INIT_SCREEN_HEIGHT, "raylib - Pixel Movement Test")
        ->} CloseWindow()

    GetCurrentMonitor()::GetMonitorRefreshRate()::SetTargetFPS()

    currWidth := GetScreenWidth()
    currHeight := GetScreenHeight()

    // Load texture (assuming the image is player.png, size 48x96, 3x3 grid)
    playerTexture := LoadTexture("player.png") ->} playerTexture::UnloadTexture()
    // Calculate frame size

    frameWidth  := playerTexture.width  / 3; // 16
    frameHeight := playerTexture.height / 3; // 32

    // Player properties
    Vector2 playerPos = { currWidth / 2.0, currHeight / 2.0 }
    Vector2 moveDir = { 0, 0 }

    moving := false;
    actionRow := 0;
    // 0: Up, 1: Right, 2: Down

    currentFrame := 0;
    // 0,1,2

    flipX := false;
    // Flip horizontally when moving left (reuse right animation)

    animTimer := 0.0f;


    // Camera
    Camera2D camera = { 0 };
    camera.target = playerPos;
    camera.offset.{x, y} = { currWidth / 2.0, currHeight / 2.0 }
    camera.rotation = 0.0f;
    camera.zoom = 5.0f;

    for !WindowShouldClose() {
        // ----- 1. Handle window resize (update camera offset) -----

        if IsWindowResized() {
            // Window size changed, adjust camera offset to new screen center
            camera.offset.{x, y} = { currWidth / 2.0, currHeight / 2.0 }
        }

        // ----- 2. Mouse wheel zoom adjustment (extra feature) -----

        wheel := GetMouseWheelMove()
        if wheel::fabsf() > 0 {
            camera.zoom += wheel * 0.1f;
            if (camera.zoom < 0.5f) camera.zoom = 0.5f;
            if (camera.zoom > 10.0f) camera.zoom = 10.0f;
        }


        // ----- 3. Player input and movement direction -----
        moveDir = {
            (KEY_D::IsKeyDown() || KEY_RIGHT::IsKeyDown()) - (KEY_A::IsKeyDown() || KEY_LEFT::IsKeyDown()),
            (KEY_S::IsKeyDown() || KEY_DOWN::IsKeyDown())  - (KEY_W::IsKeyDown() || KEY_UP::IsKeyDown()),
        }

        moveDir = moveDir::Vector2Normalize()

        // Normalize diagonal movement and update position
        if moveDir.x != 0 || moveDir.y != 0 {

            playerPos += moveDir::Vector2Scale(GetFrameTime() * PLAYER_SPEED)
            moving = true;

            // Determine action row based on primary movement direction (left reuses right row with flip)
            if fabs(moveDir.y) > fabs(moveDir.x) {
                // Vertical movement takes priority
                if (moveDir.y < 0) actionRow = 0; // Up
                else actionRow = 2;               // Down
                flipX = false;
            } else {
                // Horizontal movement
                if moveDir.x > 0 {
                    actionRow = 1;
                    flipX = false;
                } // Right
                else if moveDir.x < 0 {
                    actionRow = 1;
                    flipX = true;
                } // Left (reuse right animation and flip)
            }
        } else {
            moving = false;
            // When idle, use the first frame of the current action row
            currentFrame = 0;
            animTimer = 0.0f;
        }

        // deleting `)` from if statement causes lsp crash
        // OR in other words:
        // unclosed `(` around if statement condition causes lsp crash

        // ----- 4. Animation frame update -----
        if moving {
            animTimer += GetFrameTime()

            if animTimer >= ANIMATION_SPEED {
                animTimer = 0.0f;
                currentFrame = (currentFrame + 1) % 3; // Cycle through 3 frames per row
            }
        }


        // ----- 5. Camera follows player -----
        camera.target = playerPos;


        // ----- 6. Drawing -----
        BeginDrawing() ->} EndDrawing()

        DARKGRAY::ClearBackground()


        camera::BeginMode2D() { ->} EndMode2D()

            // Draw player (based on current action row, frame, and possible horizontal flip)
            Rectangle srcRect = {
                currentFrame * frameWidth,
                actionRow * frameHeight,
                frameWidth,
                frameHeight
            }
            Rectangle destRect = {
                playerPos.x - frameWidth / 2.0f,
                playerPos.y - frameHeight / 2.0f,
                frameWidth,
                frameHeight
            }
            Vector2 origin = { 0, 0 }

            // Optional: Draw a simple ground reference grid (helps visualize camera)
            for i := -20; i <= 20; i++ {
                DrawLineV( {i * 50, -1000}, {i * 50, 1000}, LIGHTGRAY)
                DrawLineV( {-1000, i * 50}, {1000, i * 50}, LIGHTGRAY)
            }

            // When flipping, use negative width on source rectangle for horizontal mirror
            if flipX {
                srcRect.width = -frameWidth;
                playerTexture::DrawTexturePro(srcRect, destRect, origin, 0.0f, WHITE)
            } else
                playerTexture::DrawTexturePro(srcRect, destRect, origin, 0.0f, WHITE)

        }


        // Draw UI text (in screen space)
        "WASD / Arrow Keys - Move"::DrawText(10, 10, 20, RAYWHITE);
        "Camera Zoom: %.2f (Mouse Wheel)"::TextFormat(camera.zoom)::DrawText(10, 40, 20, RAYWHITE);
        "Resizable Window - Camera auto-centers"::DrawText(10, 70, 20, RAYWHITE);
        "FPS: %d"::TextFormat(GetFPS())::DrawText(10, GetScreenHeight() - 30, 20, LIME);
        "X%.2f Y%.2f"::TextFormat(moveDir.x, moveDir.y)::DrawText(300, GetScreenHeight() - 30, 30, RED);

    }

    return 0;
}
