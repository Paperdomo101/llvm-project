typedef struct Expression Expression;

parse_expression       (Parser *parser, Precedence prec)    Expression *;
name_expression        (Parser *parser, Token token)        Expression *;
prefix_operator        (Parser *parser, Token token)        Expression *;
conditional_expression (Parser *parser, Expression *left)   Expression *;

typedef enum {
    EXPR_CONDITIONAL,
    EXPR_BINARY,
    EXPR_ASSIGN,
    EXPR_PREFIX,
    EXPR_SUFFIX,
    EXPR_CALL,
    EXPR_NAME,
} Expression_Type;

struct Expression {
    Expression_Type type;

    union {
        struct {
            Expression *condition, *then_arm, *else_arm;
        } CONDITIONAL;
        struct {
            Token_Type operator;
            Expression *left, *right;
        } BINARY;
        struct {
            String_View name;
            Expression *right;
        } ASSIGN;
        struct {
            Token_Type operator;
            Expression *right;
        } PREFIX;
        struct {
            Token_Type operator;
            Expression *left;
        } SUFFIX;
        struct {
            Expression *function;
            struct {
                size_t count, capacity;
                Expression **items;
            } args;
        } CALL;
        struct {
            String_View name;
        } NAME;
    };
};


name_expression (Parser *parser, Token token) Expression * {

    Expression *expr = sizeof(Expression)::malloc()
    expr.type = EXPR_NAME;
    expr.NAME.name = sv_from_parts(token.start, token.length)
    return expr;
}

prefix_operator (Parser *parser, Token token) Expression * {

    Expression *expr = sizeof(Expression)::malloc()
    expr.type = EXPR_PREFIX;
    expr.PREFIX.operator = token.type;
    return expr;
}

conditional_expression (Parser *parser, Expression *left) Expression * {

    condition := left;
    then_arm  := parser::parse_expression( PREC_NONE )
    parser::expect(TOK_COLON)
    else_arm  := parser::parse_expression( PREC_CONDITIONAL-1 )

    Expression *expr = sizeof(Expression)::malloc()
    expr.type = EXPR_CONDITIONAL;
    expr.CONDITIONAL.condition = condition;
    expr.CONDITIONAL.then_arm  = then_arm;
    expr.CONDITIONAL.else_arm  = else_arm;
    return expr;
}


parse_expression (Parser *parser, Precedence prec) Expression * {

    trace_fn("%d", prec)
    token := parser::consume()
    // printl("token: %s", token_strings[token.type])
    Expression *left = NULL;

    switch (token.type) {
        case TOK_IDENTIFIER:
            left = parser::name_expression(token);
            break;
        case TOK_TILDE: case TOK_BANG:
        case TOK_MINUS: case TOK_PLUS:
            left = parser::prefix_operator(token);
            break;
        default:
            "Could not parse %s"::printl( token_strings[token.type] )
            return NULL;
    }


    // printl("PREC: %d, NEXT: %d", prec, parser.next.type::get_precedence())

    while (prec < parser.next.type::get_precedence())
    {
        token = parser::consume()
        // printl("infix: %s", token_strings[token.type])
        switch (token.type) {
            case TOK_QMARK:
                left = parser::conditional_expression(left);
                break;
            default:
                "Could not parse %s"::printl( token_strings[token.type] )
                return NULL;
        }
    }
    return left;
}



punctuator_char (Token_Type type) char {
    switch (type) {
        case TOK_L_PAREN: return '(';
        case TOK_R_PAREN: return ')';
        case TOK_COMMA:   return ',';
        case TOK_EQUAL:   return '=';
        case TOK_PLUS:    return '+';
        case TOK_MINUS:   return '-';
        case TOK_STAR:    return '*';
        case TOK_SLASH:   return '/';
        case TOK_CARET:   return '^';
        case TOK_TILDE:   return '~';
        case TOK_BANG:    return '!';
        case TOK_QMARK:   return '?';
        case TOK_COLON:   return ':';
        default:          return '\0';
    }
}

print_expression (String_Builder *sb, Expression *expr)
{
    if !expr {
        printl("NULL EXPR!")
        return;
    }
    switch (expr.type) {
        case EXPR_CONDITIONAL: {
            sb::sb_appendf( "(" )
            sb::print_expression( expr.CONDITIONAL.condition )
            sb::sb_appendf( " ? " )
            sb::print_expression( expr.CONDITIONAL.then_arm )
            sb::sb_appendf( " : " )
            sb::print_expression( expr.CONDITIONAL.else_arm )
            sb::sb_appendf( ")" )
        } break;
        case EXPR_BINARY: {
            sb::sb_appendf( "(" )
            sb::print_expression( expr.BINARY.left )
            sb::sb_appendf( " %c ", expr.BINARY.operator::punctuator_char() )
            sb::print_expression( expr.BINARY.right )
            sb::sb_appendf( ")" )
        } break;
        case EXPR_ASSIGN: {
            sb::sb_appendf( "("SV_Fmt" = ", SV_Arg(expr.ASSIGN.name) )
            sb::print_expression( expr.ASSIGN.right )
            sb::sb_appendf( ")" )
        } break;
        case EXPR_PREFIX: {
            sb::sb_appendf( "(%c", expr.PREFIX.operator::punctuator_char() )
            sb::print_expression( expr.PREFIX.right )
            sb::sb_appendf( ")" )
        } break;
        case EXPR_SUFFIX: {
            sb::sb_appendf( "(" )
            sb::print_expression( expr.SUFFIX.left )
            sb::sb_appendf( "%c)", expr.SUFFIX.operator::punctuator_char() )
        } break;
        case EXPR_CALL: {
            sb::print_expression( expr.CALL.function )
            sb::sb_appendf( "(" )
            for (int i = 0; i < expr.CALL.args.count; ++i) {
                sb::print_expression( expr.CALL.args.items[i] )
                if (i < expr.CALL.args.count-1)
                    sb::sb_appendf( ", " )
            }
            sb::sb_appendf( ")" )
        } break;
        case EXPR_NAME: {
            sb::sb_appendf( SV_Fmt, SV_Arg(expr.NAME.name) )
        } break;
    }
}


parse (Parser *parser) String_Builder {

    trace_fn("")
    // savestate := *parser.lexer;
    // parser::scan_tokens()
    // da_foreach( Token, token, &parser->tokens )
    // {
    //     "%s '%.*s'\n"::printf( token_strings[token->type], token->length, token->start )
    // }
    // *parser.lexer = savestate;



    String_Builder sb = {0}

    expr := parser::parse_expression( PREC_NONE )
    &sb::print_expression( expr )


    return sb;
}


