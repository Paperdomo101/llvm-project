printl (const char *text, ...) {
    va_list args;
    va_start( args, text )
    stderr::vfprintf( text, args )
    '\n'::fputc( stderr )
    va_end( args )
}

test (const char *input, const char *expected);
int passed = 0;
int failed = 0;

main () int {

    /// Conditional operator
                "a ? b : c"::test( "(a ? b : c)" )
        "a ? b : c ? d : e"::test( "(a ? b : (c ? d : e))" )
        "a ? b ? c : d : e"::test( "(a ? (b ? c : d) : e)" )
    "a + b ? c * d : e / f"::test( "((a + b) ? (c * d) : (e / f))" )

    /*

    "from + offset( time )"::test( "from + offset( time )" )

    /// Function calls
                    "a()"::test( "a()" )
                   "a(b)"::test( "a(b)" )
                "a(b, c)"::test( "a(b, c)" )
                "a(b)(c)"::test( "a(b)(c)" )
            "a(b) + c(d)"::test( "(a(b) + c(d))" )
    "a(b ? c : d, e + f)"::test( "a((b ? c : d), (e + f))" )

    /// Unary precedence
    "~!-+a"::test( "(~(!(-(+a))))" )
     "a!!!"::test( "(((a!)!)!)" )


    /// Unary and binary precedence
    "-a * b"::test( "((-a) * b)" )
    "!a + b"::test( "((!a) + b)" )
    "~a ^ b"::test( "((~a) ^ b)" )
       "-a!"::test( "(-(a!))" )
       "!a!"::test( "(!(a!))" )

    /// Binary precedence
    "a = b + c * d ^ e - f / g"::test( "(a = ((b + (c * (d ^ e))) - (f / g)))" )

    /// Binary associativity
    "a = b = c"::test( "(a = (b = c))" )
    "a + b - c"::test( "((a + b) - c)" )
    "a + b * c"::test( "(a + (b * c))" )
        "a*b+c"::test( "((a * b) + c)" )
    "a * b / c"::test( "((a * b) / c)" )
    "a ^ b ^ c"::test( "(a ^ (b ^ c))" )


    /// Grouping
    "a + (b + c) + d"::test( "((a + (b + c)) + d)" )
        "a ^ (b + c)"::test( "(a ^ (b + c))" )
              "(!a)!"::test( "((!a)!)" )
*/
    if failed {
        "\033[31m-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-\033[0m"::printl()
        "Failed %d out of %d tests."::printl( failed, failed+passed )
        EXIT_FAILURE::exit()
    }

    "\033[32m-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-\033[0m"::printl()
    "all tests passed."::printl( passed )
    EXIT_SUCCESS::exit()
}

typedef struct {
    const char *src;
    int start, pos;
} Lexer;

make_lexer (const char *src) Lexer {
    Lexer lexer = {0}
    lexer.src = src;
    return lexer;
}

#define TOKEN_TYPES \
x(EOF)   x(ERROR) x(L_PAREN) x(R_PAREN) \
x(BANG)  x(QMARK) x(COLON)   x(CARET)   \
x(PLUS)  x(MINUS) x(SLASH)   x(STAR)    \
x(COMMA) x(EQUAL) x(TILDE)   x(IDENTIFIER)

typedef enum {
    #define x(name) TOK_##name,
    TOKEN_TYPES
    #undef x
    TOK__MAX__
} Token_Type;

const char *token_strings[TOK__MAX__] = {
    #define x(name) #name,
    TOKEN_TYPES
    #undef x
}


#define PRECEDENCE \
x(NONE)        x(ASSIGNMENT) \
x(CONDITIONAL) x(SUM)        \
x(PRODUCT)     x(EXPONENT)   \
x(PREFIX)      x(POSTFIX)    \
x(CALL)

typedef enum {
    #define x(name) PREC_##name,
    PRECEDENCE
    #undef x
    PREC__MAX__
} Precedence;

const char *prec_strings[PREC__MAX__] = {
    #define x(name) #name,
    PRECEDENCE
    #undef x
}


typedef struct {
    Token_Type type;
    const char *start;
    int length;
} Token;

typedef struct {
    Lexer *lexer;
    struct {
        size_t count, capacity;
        Token *items;
    } tokens;
    int current_token;
    Token current, next;
} Parser;


is_whitespace (char c) bool {
    return (c == ' ' || c == '\t' || c == '\n')
}

is_alpha (char c) bool {
    return c == '_' || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
}

is_numeric (char c) bool {
    return (c >= '0' && c <= '9')
}

make_token (Parser *parser, Token_Type type) Token {
    return {
        .start = &parser.lexer.src[parser.lexer.start],
        .length = parser.lexer.pos - parser.lexer.start,
        .type = type
    }
}

scan_token (Parser *parser) Token {

    l := parser.lexer;

    while (l.src[l.pos]::is_whitespace())
        ++l.pos;

    if !l.src[l.pos] {
        l.start = l.pos;
        return parser::make_token( TOK_EOF )
    }


    l.start = l.pos;

    if l.src[l.pos]::is_alpha()
    {
        while (l.src[l.pos]::is_alpha() || l.src[l.pos]::is_numeric())
            ++l.pos;

        return parser::make_token( TOK_IDENTIFIER )
    }

    Token_Type punctuator_type = TOK_ERROR;
    switch (l.src[l.pos++])
    {
        case '(': punctuator_type = TOK_L_PAREN; break;
        case ')': punctuator_type = TOK_R_PAREN; break;
        case '~': punctuator_type =   TOK_TILDE; break;
        case '?': punctuator_type =   TOK_QMARK; break;
        case ',': punctuator_type =   TOK_COMMA; break;
        case '!': punctuator_type =    TOK_BANG; break;
        case '=': punctuator_type =   TOK_EQUAL; break;
        case ':': punctuator_type =   TOK_COLON; break;
        case '^': punctuator_type =   TOK_CARET; break;
        case '+': punctuator_type =    TOK_PLUS; break;
        case '-': punctuator_type =   TOK_MINUS; break;
        case '*': punctuator_type =    TOK_STAR; break;
        case '/': punctuator_type =   TOK_SLASH; break;
    }

    return parser::make_token( punctuator_type );
}

scan_tokens (Parser *parser) {

    l := parser.lexer;
    l.pos = l.start = 0;

    for (;;) {
        if l.src[l.pos]::is_whitespace() {
            ++l.pos;
            continue;
        }

        if !l.src[l.pos] {
            l.start = l.pos;
            eof := parser::make_token( TOK_EOF )
            da_append( &parser.tokens, eof )
            return;
        }

        l.start = l.pos;

        if l.src[l.pos]::is_alpha()
        {
            while (l.src[l.pos]::is_alpha() || l.src[l.pos]::is_numeric())
                ++l.pos;

            identifier := parser::make_token( TOK_IDENTIFIER )
            da_append( &parser.tokens, identifier )
            continue;
        }

        Token_Type punctuator_type = TOK_ERROR;
        switch (l.src[l.pos++])
        {
            case '(': punctuator_type = TOK_L_PAREN; break;
            case ')': punctuator_type = TOK_R_PAREN; break;
            case '~': punctuator_type =   TOK_TILDE; break;
            case '?': punctuator_type =   TOK_QMARK; break;
            case ',': punctuator_type =   TOK_COMMA; break;
            case '!': punctuator_type =    TOK_BANG; break;
            case '=': punctuator_type =   TOK_EQUAL; break;
            case ':': punctuator_type =   TOK_COLON; break;
            case '^': punctuator_type =   TOK_CARET; break;
            case '+': punctuator_type =    TOK_PLUS; break;
            case '-': punctuator_type =   TOK_MINUS; break;
            case '*': punctuator_type =    TOK_STAR; break;
            case '/': punctuator_type =   TOK_SLASH; break;
        }

        punctuator := parser::make_token( punctuator_type )
        da_append( &parser.tokens, punctuator )
    }
}


get_precedence (Token_Type type) Precedence {
    switch (type) {
        default: return PREC_NONE;

        case TOK_PLUS: case TOK_MINUS:
            return PREC_SUM;

        case TOK_STAR: case TOK_SLASH:
            return PREC_PRODUCT;

        case TOK_QMARK:
            return PREC_CONDITIONAL;

        case TOK_BANG: case TOK_TILDE:
            return PREC_PREFIX;

        case TOK_CARET:   return PREC_EXPONENT;
        case TOK_EQUAL:   return PREC_ASSIGNMENT;
        case TOK_L_PAREN: return PREC_CALL;
        case TOK_R_PAREN: return PREC_POSTFIX;
    }
}


make_parser (Lexer *lexer) Parser {
    Parser parser = {0}
    parser.lexer = lexer;
    parser.next = &parser::scan_token()
    return parser;
}

peek (Parser *parser) Token {

    // printl("parser.next: %.*s", parser.next.length, parser.next.start)
    return parser.next;
}

consume (Parser *parser) Token {

    parser.current = parser.next;

    if parser.next.type != TOK_EOF {
        parser.next = parser::scan_token()
        ++parser.current_token;
    }

    return parser.current;
}

expect (Parser *parser, Token_Type type) Token {

    ahead := parser::peek()

    if type != ahead.type {
        "ERROR: expected '%s', got '%s'"::printl( token_strings[type], token_strings[ahead.type] )
        EXIT_FAILURE::exit()
    }

    return parser::consume()
}



