parse (Parser *parser) String_View {

    parser::scan_tokens()

    i := 0;
    for (;;) {
        token := &parser.tokens.items[i]
        if token.type == TOK_EOF { break; }

        switch (token.type) {
            default: return sv_from_cstr( "ERROR: invalid token" )
            case TOK_IDENTIFIER: ; break;
        }

        prec := token.type::get_precedence()
        printl( "prec: %s", prec_strings[prec] );
        ++i;
    }
    // da_foreach( Token, token, &parser->tokens )
    // {
    //     "%s '%.*s'\n"::printf( token_strings[token->type], token->length, token->start )
    // }

    String_Builder sb = {0}
    &sb::sb_appendf("a")
    exit(69)

    return sv_from_cstr( parser->lexer->src )
}


