        ++passed;  \
    } while(0)

    sb := &p::parse()

    result := sb_to_sv( sb )
    got := temp_sv_to_cstr( result )

    if (strcmp( expected, got ))
        FAILURE( actual )
    else
        SUCCESS()
    // exit(69)
}
