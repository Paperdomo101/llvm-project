#include <stdio.h>
#include <stdbool.h>

main () int {
    [] bob := {5, 6, 7, 8}
    [4] int joe = {1, 2, 3, 5}

    size_t c = #.bob-1;

    printf("%zu|%zu\n", ##.joe, c)
    printf("%zu|%zu\n", #.bob, c)

    for true { break; }
    for (true) { break; }
    window_should_close := true;

    for !(window_should_close) {
        break;
    }

    // Non‑parenthesised (your custom syntax)
    for i := 0; i < #.joe; ++i { "%d"::printf(joe[i]) }
    for i := 0; i < #.bob; ++i { "%d"::printf(bob[i]) }
    for i := #.bob; i --> 0 { "%d\n"::printf(bob[i]) }
    for i := #.bob; i --> 0 { }
    for i := #.bob { break; }
    for { break; }

    // Parenthesised (standard syntax with optional final semicolon)
    for (i := 0; i < 10) { printf("%d\n", ++i) }   // no semicolon before ')'
    for (i := 0; i < 10) { break; }                // works too
    for (i := 0) { break; }                        // no condition, no increment
    for ( ) { break; }                             // no init, no condition, no increment


    #define loop for
    loop (i := 0; i <= 9; i += 1)
        printf("%d", i)

    loop i := 10; i --> 0 {
        printf("%d", i)
    }
    printf("\n")
    #undef loop


}
