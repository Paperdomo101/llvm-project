// tests/anonymous_local_structs_runtime.c4
#include <stdio.h>

main () int {
    _ {
        int a;
        int b;
    } s1 = {10, 20};

    static _ {
        int x;
        int y;
    } s2 = {30, 40};

    if (s1.a != 10 || s1.b != 20) return 1;
    if (s2.x != 30 || s2.y != 40) return 2;

    printf("Anonymous local structs runtime test passed!\n");
    return 0;
}
