// tests/enum_collision.c4
// Verify that enum members do not collide across different C4 enums.

ScreenFlags : unsigned char {
    BASIC               = 0,
    USE_CANVAS          = 1 << 0,
    FIXED_ASPECT        = 1 << 1,
    INTEGER_SCALING     = 1 << 2,
    CROP_CANVAS         = 1 << 3,
}

DisplayModes : unsigned char {
    BASIC,
    STRETCH,
    KEEP_ASPECT,
    PIXEL_PERFECT,
    PIXEL_CROPPED,
}

main() int {
    if (ScreenFlags.BASIC != 0) return 1;
    if (DisplayModes.BASIC != 0) return 2;
    return 0;
}
