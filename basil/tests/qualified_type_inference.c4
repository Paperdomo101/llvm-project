// ============================================================================
// C4 Type‑Inferred Assignment & Array Test Suite
// ============================================================================

// Simple assertions
#define assert_eq(x, y) if ((x) != (y)) { printf("FAIL at line %d: %d != %d\n", __LINE__, (int)(x), (int)(y)); exit(1); }
#define assert_str_eq(x, y) if (strcmp((x), (y)) != 0) { printf("FAIL at line %d: expected %s, got %s\n", __LINE__, (y), (x)); exit(1); }

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// ----------------------------------------------------------------------------
// 1. CONST
// ----------------------------------------------------------------------------
void test_const() {
    const a := 5;
    assert_eq(a, 5);
    a = 10; // ERROR: a is const

    const b := {1, 2, 3};
    assert_eq(b.count, 3);
    assert_eq(b.items[0], 1);
    // b.items[0] = 42; // ERROR: const
}

// ----------------------------------------------------------------------------
// 2. EXPLICIT QUALIFIERS
// ----------------------------------------------------------------------------
void test_explicit_qualifiers() {
    [] c := {10, 20, 30};
    assert_eq(c.count, 3);
    assert_eq(c.items[0], 10);

    d[] := {40, 50, 60};
    assert_eq(d[0], 40);
    assert_eq(d[1], 50);

    const [] e := {1, 2, 3};
    assert_eq(e.count, 3);
    // e.items[0] = 5; // ERROR: const

    const f[] := {7, 8, 9};
    assert_eq(f[0], 7);
}

// ----------------------------------------------------------------------------
// 3. DEFAULT INFERENCE
// ----------------------------------------------------------------------------
void test_default_inference() {
    g := {1, 2, 3};
    assert_eq(g.count, 3);
    assert_eq(g.items[0], 1);
    h := {1, 2, 3.0}; // ERROR: mixed types
}

// ----------------------------------------------------------------------------
// 4. STRING LITERALS
// ----------------------------------------------------------------------------
void test_string_literals() {
    s := "hello";
    assert_eq(s.count, 5);
    assert_str_eq(s.items, "hello");

    [] s_c4 := "world";
    assert_eq(s_c4.count, 5);
    assert_str_eq(s_c4.items, "world");

    s_c[] := "world";          // raw C array
    assert_str_eq(s_c, "world");

    s3 := (char[])"hello";     // cast → C array char[6]
    assert_str_eq(s3, "hello");

    // Direct C4 char array with string literal
    [] char s4 = "hi";
    assert_eq(s4.count, 2);
    assert_str_eq(s4.items, "hi");
}

// ----------------------------------------------------------------------------
// 5. COMPOUND LITERALS & STRUCTS
// ----------------------------------------------------------------------------
typedef struct { float x, y; }  Vector2;
typedef struct { int id; char *name; }  Thing;

void test_compound_literals() {
    pos := (Vector2){0, 0};
    assert_eq((int)pos.x, 0);
    assert_eq((int)pos.y, 0);
    pos.x = 10;

    arr := (int[]){1, 2, 3};
    assert_eq(arr[0], 1);
    assert_eq(arr[1], 2);

    [] arr_c4 := (int[]){4, 5, 6};   // C4 array despite cast
    assert_eq(arr_c4.count, 3);
    assert_eq(arr_c4.items[0], 4);

    arr_c[] := (int[]){7, 8, 9};    // C array
    assert_eq(arr_c[0], 7);

    thing := (Thing){42, "answer"};
    assert_eq(thing.id, 42);
    assert_str_eq(thing.name, "answer");
}

// ----------------------------------------------------------------------------
// 6. DESTRUCTURING
// ----------------------------------------------------------------------------
void test_destructuring() {
    x, y := {10, 20};
    assert_eq(x, 10);
    assert_eq(y, 20);

    a, b, c := {1, 2, 3};
    assert_eq(a, 1);
    assert_eq(b, 2);
    assert_eq(c, 3);

    s1, s2 := {"hello", "world"};
    assert_str_eq(s1.items, "hello");
    assert_str_eq(s2.items, "world");

    m, n := {(int){5}, (int){6}};
    assert_eq(m, 5);
    assert_eq(n, 6);
}

// ----------------------------------------------------------------------------
// 7. NESTED INITIALIZERS
// ----------------------------------------------------------------------------
typedef struct { int x, y; } Point;

void test_nested_initializers() {
    [] Point points = { {1,2}, {3,4}, {5,6} };
    assert_eq(points.count, 3);
    assert_eq(points.items[0].x, 1);
    assert_eq(points.items[0].y, 2);
    assert_eq(points.items[1].x, 3);
    assert_eq(points.items[1].y, 4);
}

// ----------------------------------------------------------------------------
// 8. SHADOWING / SCOPE
// ----------------------------------------------------------------------------
void test_shadowing() {
    v := 10;
    {
        v := 20;
        assert_eq(v, 20);
    }
    assert_eq(v, 10);
}

// ----------------------------------------------------------------------------
// 9. EDGE CASES
// ----------------------------------------------------------------------------
void test_edge_cases() {
    [] int empty = {};
    assert_eq(empty.count, 0);
    // empty.items should be NULL; we don't dereference.

    [] char *args = { "hello", "world", NULL };
    assert_eq(args.count, 3);
    assert_str_eq(args.items[0], "hello");
    assert_str_eq(args.items[1], "world");

    [] const char *single = { "single" };
    assert_eq(single.count, 1);
    assert_str_eq(single.items[0], "single");
}

// ----------------------------------------------------------------------------
// 10. FUNCTION PARAMETERS (by value)
// ----------------------------------------------------------------------------
void verify_param([] int arr, size_t expected_count, int expected_0, int expected_1) {
    assert_eq(arr.count, expected_count);
    assert_eq(arr.items[0], expected_0);
    assert_eq(arr.items[1], expected_1);
    arr.items[0] = 999;  // local copy
}

void test_parameter_passing() {
    [] int my_arr = {100, 200};
    verify_param(my_arr, 2, 100, 200);
    assert_eq(my_arr.items[0], 100);  // original unchanged
}

// ----------------------------------------------------------------------------
// MAIN
// ----------------------------------------------------------------------------
int main() {
    test_const();
    test_explicit_qualifiers();
    test_default_inference();
    test_string_literals();
    test_compound_literals();
    test_destructuring();
    test_nested_initializers();
    test_shadowing();
    test_edge_cases();
    test_parameter_passing();

    printf("All tests passed!\n");
    return 0;
}
