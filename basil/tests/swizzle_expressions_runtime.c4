// test expressions in member swizzles

typedef struct { float x, y, z; } Vector3;

int main() {
    Vector3 position = {1.0f, 2.0f, 3.0f};
    Vector3 top;
    top.{x, y, z} = position.{x, y + 1.25f, z - 0.5f};

    if (top.x != 1.0f) return 1;
    if (top.y != 3.25f) return 2;
    if (top.z != 2.5f) return 3;

    return 0;
}
