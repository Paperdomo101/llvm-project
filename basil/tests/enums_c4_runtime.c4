// tests/enums_c4_runtime.c4 — Consolidated C4 enum runtime tests
// Covers:
//   - Enum declarations (Name : Type { ... }, iota #, qualified/unqualified access)
//   - Implicit .Member dot access, .{A,B} OR groups, switch on enums
//   - Ternary type preservation (cond ? .A : .B produces enum type)
//   - Implicit :: receiver shorthand (::method() using embed param)
#include <stdio.h>
#include <stdlib.h>

// ── Enum declarations ────────────────────────────────────────────────────────

Flags : unsigned char {
    X = 1 << 0, Y = 1 << 1, Z = 1 << 2, W = 1 << 3,
}

Direction : int {
    NORTH = #, SOUTH = #, EAST  = #, WEST  = #,
}

Power : int {
    P1 = 1 << #, P2 = 1 << #, P4 = 1 << #,
}

ExitStatus : int {
    OK = 0, ERR = 1, FATAL = 2,
}

[#.ExitStatus] int status_meanings = {
    [.OK] = 100, [.ERR] = 200, [.FATAL] = 300
}

// For ternary test
TernaryEnum : int {
    A, B, C, D, E
}

// ── Struct and helper for implicit :: test ───────────────────────────────────

typedef struct {
    int val;
} MyCtx;

print_token (TernaryEnum t) {
    printf("  token=%u\n", t);
}

add_enum (<- &MyCtx ctx, TernaryEnum t) {
    // no-op test helper
}

use_implicit_doublecolon (<- &MyCtx ctx) {
    ::add_enum(.A);
    ::add_enum(.B);
    int cond = 1;
    ::add_enum(cond ? .D : .E);
}

// ── Helpers ──────────────────────────────────────────────────────────────────

check_flags (Flags f) int { return (int)f; }

// ── main ─────────────────────────────────────────────────────────────────────
main () int {

    // ── Unqualified member access ─────────────────────────────────────────────
    if (X != 1) { puts("[FAIL] X");  exit(1); }
    if (Y != 2) { puts("[FAIL] Y");  exit(1); }
    if (Z != 4) { puts("[FAIL] Z");  exit(1); }
    if (W != 8) { puts("[FAIL] W");  exit(1); }

    // ── Qualified member access (Enum.Member) ─────────────────────────────────
    if (Flags.X != 1) { puts("[FAIL] Flags.X"); exit(1); }
    if (Flags.Y != 2) { puts("[FAIL] Flags.Y"); exit(1); }
    if (Flags.Z != 4) { puts("[FAIL] Flags.Z"); exit(1); }
    if (Flags.W != 8) { puts("[FAIL] Flags.W"); exit(1); }

    // ── Iota counter ──────────────────────────────────────────────────────────
    if (NORTH != 0) { puts("[FAIL] NORTH"); exit(1); }
    if (SOUTH != 1) { puts("[FAIL] SOUTH"); exit(1); }
    if (EAST  != 2) { puts("[FAIL] EAST");  exit(1); }
    if (WEST  != 3) { puts("[FAIL] WEST");  exit(1); }

    // ── Bit-shift iota ────────────────────────────────────────────────────────
    if (P1 != 1) { puts("[FAIL] P1"); exit(1); }
    if (P2 != 2) { puts("[FAIL] P2"); exit(1); }
    if (P4 != 4) { puts("[FAIL] P4"); exit(1); }

    // ── Implicit dot in function call: .Member ────────────────────────────────
    if (check_flags(.X) != 1) { puts("[FAIL] .X"); exit(1); }
    if (check_flags(.Y) != 2) { puts("[FAIL] .Y"); exit(1); }
    if (check_flags(.Z) != 4) { puts("[FAIL] .Z"); exit(1); }
    if (check_flags(.W) != 8) { puts("[FAIL] .W"); exit(1); }

    // ── .{M1, M2} bitwise-OR group ───────────────────────────────────────────
    if (check_flags(.{X, Y})    != 3)  { puts("[FAIL] .{X,Y}");    exit(1); }
    if (check_flags(.{X, Y, Z}) != 7)  { puts("[FAIL] .{X,Y,Z}");  exit(1); }
    if (check_flags(.{X, W})    != 9)  { puts("[FAIL] .{X,W}");    exit(1); }
    if (check_flags(.{W})       != 8)  { puts("[FAIL] .{W}");       exit(1); }
    if (check_flags(.{X,Y,Z,W}) != 15) { puts("[FAIL] all flags");  exit(1); }

    // ── Type-inferred variable from enum member ───────────────────────────────
    d := NORTH;
    if (d != 0) { puts("[FAIL] d := NORTH"); exit(1); }

    b := Flags.X;
    if (b != 1) { puts("[FAIL] b := Flags.X"); exit(1); }

    // ── switch on enum value ──────────────────────────────────────────────────
    switch (d) {
        case NORTH: break;
        default:    puts("[FAIL] switch NORTH"); exit(1);
    }

    dir := EAST;
    switch (dir) {
        case NORTH: puts("[FAIL] switch EAST got NORTH"); exit(1); break;
        case EAST:  break;
        default:    puts("[FAIL] switch EAST default");   exit(1); break;
    }

    // ── ExitStatus enum + designed array initializers ─────────────────────────
    if (OK != 0) { puts("[FAIL] OK"); exit(1); }
    if (ERR != 1) { puts("[FAIL] ERR"); exit(1); }
    if (FATAL != 2) { puts("[FAIL] FATAL"); exit(1); }
    if (#.status_meanings != 3)  { puts("[FAIL] #.status_meanings"); exit(1); }
    if (status_meanings[0] != 100) { puts("[FAIL] status[0]"); exit(1); }
    if (status_meanings[1] != 200) { puts("[FAIL] status[1]"); exit(1); }
    if (status_meanings[2] != 300) { puts("[FAIL] status[2]"); exit(1); }

    // ── Enum ternary type preservation ────────────────────────────────────────
    {
        int cond = 1;
        TernaryEnum t1 = cond ? .B : .C;
        if (t1 != .B) { puts("[FAIL] ternary .B:.C"); exit(1); }
        cond = 0;
        TernaryEnum t2 = cond ? .D : .E;
        if (t2 != .E) { puts("[FAIL] ternary .D:.E"); exit(1); }
        cond = 1;
        print_token(cond ? .A : .B);
    }

    // ── Implicit :: receiver shorthand ────────────────────────────────────────
    {
        MyCtx ctx = {42};
        ctx::use_implicit_doublecolon();
    }

    puts("[PASS] C4 enum tests passed.");
    return 0;
}
