// tests/forloop_bool_runtime.c4
// Runtime tests for while-like for-loop boolean conditions:
//   for true { }         — bare keyword as condition
//   for (true) { }       — parenthesised
//   for !(expr) { }      — unary not as condition
//   for expr { }         — arbitrary boolean expression
// Exit 0 = all assertions passed.
#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

int read_helper(char *err) { (void)err; return 0; }

main () int {
    int count;

    // for true — loops until break
    count = 0;
    for true { count++; if (count >= 3) break; }
    if (count != 3) { printf("[FAIL] for true: %d\n", count); exit(1); }

    // for (true) — parenthesised form
    count = 0;
    for (true) { count++; if (count >= 2) break; }
    if (count != 2) { printf("[FAIL] for (true): %d\n", count); exit(1); }

    // for !(0) — negated zero = true
    count = 0;
    for !(0) { count++; if (count >= 4) break; }
    if (count != 4) { printf("[FAIL] for !(0): %d\n", count); exit(1); }

    // for expr — stops when expression becomes false
    int i = 5;
    for i > 0 { i--; }
    if (i != 0) { printf("[FAIL] for i>0: i=%d\n", i); exit(1); }

    // for (expr) — parenthesised arbitrary expression
    i = 3;
    for (i > 0) { i--; }
    if (i != 0) { printf("[FAIL] for (i>0): i=%d\n", i); exit(1); }

    // C4 [] / ^ syntax in if / for loop declarations
    if char err[]; read_helper(err.items) == 0 {
        if (#.err != 0) { printf("[FAIL] if char err[] count\n"); exit(1); }
    }
    if ^char p_err = NULL; p_err == NULL {
        // ok
    }
    for char err[]; read_helper(err.items) == 0; {
        break;
    }

    puts("[PASS] For-loop boolean condition tests passed.");
    return 0;
}
