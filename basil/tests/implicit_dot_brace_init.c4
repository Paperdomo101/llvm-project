// tests/implicit_dot_brace_init.c4 — Implicit .Member dot in brace initializers
// Covers:
//   - {.member} in [N]T array initializers
//   - {.field = .value} mixed designator + implicit dot in struct init
#include <stdio.h>
#include <stdlib.h>

// ── Enum declarations ────────────────────────────────────────────────────────

Color : int { RED = 1, GREEN = 2, BLUE = 3 }
Size  : int { SMALL = 10, MEDIUM = 20, LARGE = 30 }

// ── Struct declarations ──────────────────────────────────────────────────────

Widget {
    Color color;
    Size  size;
    int   id;
}

// ── Tests ──────────────────────────────────────────────────────────────────

main () int {
    printf("==================================================\n");
    printf("   Implicit .Member dot in brace initializers\n");
    printf("==================================================\n\n");

    // TEST 1: C4 array with implicit dot enum values
    {
        [3] Color palette = {.RED, .GREEN, .BLUE};
        if (palette[0] != RED || palette[1] != GREEN || palette[2] != BLUE) {
            printf("[FAIL] Test 1: C4 array with .Member inits\n");
            exit(1);
        }
        printf("  [OK] Test 1: [3] Color arr = {.RED, .GREEN, .BLUE}\n");
    }

    // TEST 2: Struct with mixed designator and implicit dot value
    {
        Widget w = {.color = .BLUE, .size = .LARGE, .id = 42};
        if (w.color != BLUE || w.size != LARGE || w.id != 42) {
            printf("[FAIL] Test 2: mixed designator + .Member value\n");
            exit(1);
        }
        printf("  [OK] Test 2: Widget w = {.color = .BLUE, .size = .LARGE, .id = 42}\n");
    }

    // TEST 3: Explicit type array with .Member values
    {
        [2] Size sizes = {.SMALL, .LARGE};
        if (sizes[0] != SMALL || sizes[1] != LARGE) {
            printf("[FAIL] Test 3: explicit type array with .Member\n");
            exit(1);
        }
        printf("  [OK] Test 3: [2] Size sizes = {.SMALL, .LARGE}\n");
    }

    printf("\n==================================================\n");
    printf("   All implicit dot brace-init tests PASSED\n");
    printf("==================================================\n");
    return 0;
}
