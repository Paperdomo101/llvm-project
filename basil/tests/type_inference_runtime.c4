// tests/type_inference_runtime.c4
#include <stdio.h>
#include <stdlib.h>

typedef struct { float x, y; } Vector2;
typedef struct { float x, y, z; } Vector3;

int main() {
    // Basic lambdas/closures matching your custom syntax
    get_vector := ^() Vector2 { return (Vector2){10.0f, 20.0f}; };
    get_float  := ^() float { return 5.0f; };

    // --- TEST 1, 2 & 4: Scalar and Float Inference ---
    a := 42;
    b := 3.14f;
    c := get_float();
    if (a != 42 || b < 3.0f || c != 5.0f) exit(1);

    // --- TEST 3, 5, 7 & 8: Destructuring & Swizzling ---
    swiz := get_vector();
    d := swiz.x;
    if (d != 10.0f) exit(1);

    f, g := swiz.{x, y};
    if (f != 10.0f || g != 20.0f) exit(1);

    h, i := swiz.{y, x};
    if (h != 20.0f || i != 10.0f) exit(1);

    // --- TEST 14 & 15: Scoping and Shadowing ---
    v1 := 10;
    {
        v1 := 20;
        if (v1 != 20) exit(1);
    }
    if (v1 != 10) exit(1);

    // --- TEST 16: Function-call inline swizzle ---
    w, x_val := get_vector().{x, y};
    if (w != 10.0f || x_val != 20.0f) exit(1);

    // --- TEST 17: Side-Effect Evaluation Order ---
    __block int counter = 0;
    next := ^() float {
        counter = counter + 1;
        return (float)counter;
    };

    y, z := { next(), next() };
    if (y != 1.0f || z != 2.0f || counter != 2) exit(1);

    // --- TEST 18 & 25: Chained Visibility ---
    aa, bb := swiz.{x, y};
    cc := aa;
    dd := bb;
    if (cc != 10.0f || dd != 20.0f) exit(1);

    // --- TEST 23: Triple Swizzle ---
    Vector3 base3 = {1.0f, 2.0f, 3.0f};
    kk, ll, mm := base3.{x, y, z};
    if (kk != 1.0f || ll != 2.0f || mm != 3.0f) exit(1);

    printf("All Type-Inference Execution Assertions Passed Natively.\n");
    return 0;
}
