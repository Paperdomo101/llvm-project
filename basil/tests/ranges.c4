#include <stdio.h>

main () int {
    for 0..9 { } // inclusive
    for 0..<10 { } // exclusive
    for 0..-10 { } // negative
    for 0..2..10 { } // step size (2)

    for i := 0..9 { } // range can be assigned
    for i := 0..<10 { }
    for i := 0..-10 { }
    for i := 0..2..10 { }   // equivalent: for i := 0; i < 10; i += 2 {...}
    for i := 0.. { break; } // count up forever starting from 0
    for i := 0..-1.. { break; } // count down forever starting from 0


    for i := 0..1..10 { // range format is start..step..limit (step is optional)
        for int j = 0..40 {
            if j % 3 { continue; } // skips the inner loop
            if j == 9 { continue i; } // skips the loop that defined 'i'
            if i == 5 { break i; } // break the loop that defined 'i'
        }
    }

    [] bobs := { "one", "two", "three", "four", "five" }

    for i := b..bobs {   }	 // equivalent: for i := 0; i > #.bobs; i++ {
                             //				    b := bobs[i]
                             //				}
    for b..bobs {			 // equivalent: for _ := 0; _ > #.bobs; _++ {
        // b is a copy       //					b := bobs[_]
    }						 //				}
    for ^b..bobs {			 // equivalent: for _ := 0; _ > #.bobs; _++ {
        // b is a pointer    //					b := &bobs[_]
    }   					 //				}
    for &b..bobs {           // equivalent: for _ := 0; _ > #.bobs; _++ {
        // b is a reference  //					&Bob b = bobs[_]
    }						 //				}

    const BIG := 100UL;
    counter := 0;
    for 0..BIG {
        ++counter;
    }

    for 0..#.__func__ {
        putchar('-');
    }
}
