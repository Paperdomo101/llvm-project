#include <stdio.h>
int main() {

    [] int ao = {1, 2, 3}
    int ab[] = {1, 2, 3}

    const aa := 5;
    a, b := {1, 2}
    printf("%d, %d, %d\n", aa, a, b )

    test[] := {1,2,3}
    []test := {4,5,6}
    toby := {7,8,9}
    // test[] := {1, 2, 3}
    // []test := {1, 2, 3}

    a := (char(*)[4])0; // this is fine
    b := (char*)0;      // also fine

    // BUG: int[] becomes int
    c := (int[]){1,2,3} // Excess elements in scalar initializer

    // BUG: char[] becomes char
    p := (char[]){ 'a', '\0' }; // Excess elements in scalar initializer


    c[] := {1,2,3} // expected to be C array of ints
    p[] := {(char)'a', (char)'\0'} // expected to be C array of chars
    char p1[] = {'a', '\0'} // expected to be C array of chars
    p2[] := {'a', '\0'} // expected to be C array of ints

    [] c1 := {1,2,3} // expected to be C4 array of ints
    [] p3 := {(char)'a', (char)'\0'} // expected to be C4 array of chars
    [] char p4 = {'a', '\0'} // expected to be C4 array of chars
    [] p5 := {'a', '\0'} // expected to be C4 array of ints

}
