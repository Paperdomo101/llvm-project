#include <stdio.h>

AddInts / add (int a, b) int { return a + b; }

int main() {
    // Call via primary name
    int r1 = AddInts(10, 5);
    printf("AddInts(10, 5): %d (expect 15)\n", r1);

    // Call via alias
    int r2 = add(3, 7);
    printf("add(3, 7): %d (expect 10)\n", r2);

    return 0;
}
