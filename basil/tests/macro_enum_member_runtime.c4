#include <stdio.h>
#include <assert.h>

#define EOF (-1)
#define NULL ((void*)0)
#define READ 100
#define WRITE 200

TokenType : {
    EOF,
    NULL,
    READ = 50,
    WRITE
}

enum StandardEnum {
    EOF,
    NULL,
    READ = 10,
    WRITE
};

int main(void) {
    TokenType t1 = .EOF;
    TokenType t2 = TokenType.NULL;
    TokenType t3 = TokenType.READ;
    TokenType t4 = .WRITE;

    assert((int)t1 == 0);
    assert((int)t2 == 1);
    assert((int)t3 == 50);
    assert((int)t4 == 51);

    enum StandardEnum s1 = StandardEnum.EOF;
    enum StandardEnum s2 = .NULL;
    enum StandardEnum s3 = StandardEnum.READ;
    enum StandardEnum s4 = .WRITE;

    assert((int)s1 == 0);
    assert((int)s2 == 1);
    assert((int)s3 == 10);
    assert((int)s4 == 11);

    printf("Macro enum members runtime test passed successfully!\n");
    return 0;
}
