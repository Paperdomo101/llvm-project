#include <stdio.h>

int side_effects_called = 0;

int fn_with_side_effects() {
    side_effects_called++;
    return 5;
}

int main() {
    int result = 0;

    // Spaced form: || == with side effects (chain LHS is re-evaluated per comparison)
    side_effects_called = 0;
    if (fn_with_side_effects() == 5 || == 6 || == 7) {
        result = 1;
    }
    printf("Side-effect || == : result=%d side_effects=%d (expect 1, 1)\n",
           result, side_effects_called);

    // Spaced form with non-matching value
    side_effects_called = 0;
    result = 0;
    if (fn_with_side_effects() == 99 || == 6 || == 7) {
        result = 1;
    }
    // NOTE: side_effects=3 because the chain LHS is re-evaluated for each comparison.
    // Future optimization may cache the LHS in a temp variable.
    printf("Side-effect || == no-match: result=%d side_effects=%d (expect 0, 3)\n",
           result, side_effects_called);

    // Compact form for comparison
    int c = ' ';
    if (c == ' ' ||== '\t' ||== '\n') {
        printf("Compact ||== works: YES (expect YES)\n");
    }

    // Spaced || == form
    c = ' ';
    if (c == ' ' || == '\t' || == '\n') {
        printf("Spaced || == works: YES (expect YES)\n");
    }

    // Spaced || != form
    c = 'x';
    if (c != 'a' || != 'b' || != 'c') {
        printf("Spaced || != works: YES (expect YES)\n");
    }

    // Spaced && == form
    int a = 10, b = 10;
    if (a == 10 && == b) {
        printf("Spaced && == works: YES (expect YES)\n");
    }

    return 0;
}
