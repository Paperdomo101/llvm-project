#include <stdio.h>
#include <stdlib.h>

// Helper structure to verify values without hard-crashing immediately
void assert_equal(int actual, int expected, const char *msg) {
    if (actual != expected) {
        printf("[FAIL] Assertion broken: %s (Got %d, Expected %d)\n", msg, actual, expected);
        exit(1);
    }
}

// Custom parameter grouping reference mutator function
void modify_by_ref(&int r1, r2) {
    r1 += 10;
    r2 *= r1;
}


other (&int ref) {
    ref += 4;
}

something (&int ref) {
    other(ref) // old error: Cannot take the address of pass-by-reference parameter 'ref'; doing so violates language safety guarantees
}


struct DummyArg {
    int value;
};

void run_test_edge_case(&struct DummyArg arg) {
    append := ^(&struct DummyArg outer_arg, int val) {
        outer_arg.value = val;
    };
    arg::append(42);
}


int main() {
    printf("==================================================\n");
    printf("Executing Pass-By-Reference Variable Verification...\n");
    printf("==================================================\n");

    _ := 10;
    something(_)
    assert_equal(_, 14, "Pass reference through multiple functions")

    int a = 20;
    int b = 3;

    // 1. Verify standard function call syntax reference tracking
    modify_by_ref(a, b);
    assert_equal(a, 30, "Standard call reference mutation index 0 (20 + 10)");
    assert_equal(b, 90, "Standard call reference mutation index 1 (3 * 30)");
    printf("[PASS] Standard function call reference passing verified.\n");

    // Reset baselines for the next execution format pass
    a = 20;
    b = 3;

    // 2. Verify method pipeline dispatch pipe syntax reference tracking
    a::modify_by_ref(b);
    assert_equal(a, 30, "Pipeline call reference mutation index 0 (20 + 10)");
    assert_equal(b, 90, "Pipeline call reference mutation index 1 (3 * 30)");
    printf("[PASS] Method pipeline dispatch reference passing verified.\n");

    // 3. Verify edge case: pass-by-ref parameter as method dispatch receiver to local function block
    struct DummyArg dummy = { 0 };
    run_test_edge_case(dummy);
    assert_equal(dummy.value, 42, "Pass-by-ref parameter method dispatch to local function block works");
    printf("[PASS] Edge case: pass-by-ref parameter method dispatch to local function block verified.\n");

    printf("\n[SUCCESS] Pass-By-Reference Subsystem Validated Successfully!\n");
    return 0;
}
