#include <stdio.h>

typedef struct { int x, y; } Vector2;

AddInts / add (int a, b) int { return a + b; }
Vector2Add / add (Vector2 a, b) Vector2 { return (Vector2){a.x + b.x, a.y + b.y}; }

int main() {
    int failures = 0;

    // :: dispatch with int receiver
    int r = 10::add(5);
    if (r != 15) { printf("FAIL: 10::add(5) = %d (expect 15)\n", r); failures++; }

    // :: dispatch with Vector2 receiver
    Vector2 v = (Vector2){4, 6};
    Vector2 v2 = (Vector2){9, 8};
    Vector2 result = v::add(v2);
    if (result.x != 13 || result.y != 14) {
        printf("FAIL: v::add(v2) = {%d, %d} (expect {13, 14})\n", result.x, result.y);
        failures++;
    }

    // Primary name calls should still work
    int r1 = AddInts(10, 5);
    if (r1 != 15) { printf("FAIL: AddInts(10, 5) = %d\n", r1); failures++; }

    Vector2 r2 = Vector2Add(v, v2);
    if (r2.x != 13 || r2.y != 14) {
        printf("FAIL: Vector2Add = {%d, %d}\n", r2.x, r2.y);
        failures++;
    }

    if (failures == 0) printf("All overloaded alias tests passed!\n");
    return failures;
}
