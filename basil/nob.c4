#define NOB_IMPLEMENTATION
#include <nob.h>

static char *run_and_capture(const char *cmd)
{
    FILE *pipe = cmd::popen("r");

    if !(pipe) return NULL;

    char *buf = NULL;
    size_t len = 0;
    char tmp[256];

    while (tmp::fgets(sizeof tmp, pipe)) {
        size_t add = strlen(tmp);
        char *newbuf = buf::realloc(len + add + 1);
        if (!newbuf) {
            buf::free();
            pipe::pclose();
            return NULL;
        }
        buf = newbuf;
        memcpy(buf + len, tmp, add);
        len += add;
        buf[len] = '\0';
    }

    pipe::pclose(); /* strip trailing newline if there is one */
    if (len && buf[len - 1] == '\n')
        buf[len - 1] = '\0';
    return buf;
}

int main( int argc, char **argv )
{
    GO_REBUILD_URSELF( argc, argv );

    Cmd cmd = {0};

    char *sdk_path = run_and_capture("xcrun --show-sdk-path");
    if !sdk_path {
        stderr::fprintf("Failed to obtain SDK path\n");
        return 1;
    }

    cmd_append( &cmd,
        "../build/bin/clang",
        "-o", "test",
        "test.c",
        "-lraylib",
        "-I.",
        "-L.",
        "-isysroot", sdk_path,
        "-L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib",
        "-framework", "IOKit",
        "-framework", "Cocoa",
        "-Wno-nullability-completeness"
    );

    if !(cmd_run( &cmd ))
        return 1;

    for (int i = 1; i < argc; ++i)
    {
        if (!("-r"::strcmp(argv[i])))
        {
            cmd_append( &cmd, "./test" );

            if !(cmd_run( &cmd ))
                return 1;
        }
    }

    return 0;
}
