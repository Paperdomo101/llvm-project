#define NOB_IMPLEMENTATION
#include "nob.h"
#include "raylib.h"
#include "raymath.h"

#define IsHeld IsKeyDown

add (int a, b) int {
    return a + b;
}

&Vector2 Vector2_add (&Vector2 a, Vector2 b)
{
    a.x += b.x;
    a.y += b.y;
    return a;
}

float *clamp(float *f, min, max)
{
    *f = (*f < min) ? min : (*f > max) ? max : *f;
    return f;
}

main (int argc, char **argv) int {
    a := 20ul;
    b := "hi!\n";

    "%d\n"::printf( argc );

    "%d\n"::printf( -2::add(4) );

    if !(a == 10) {
        "wow!\n"::printf()
    } else {
        "oof!\n"::printf()
    }

    pos := (Vector2){0, 0}
    pos::Vector2_add( {40, 50} ); // <-- type inferred

    struct Point { int x; int y; } p = { 2, 3 };

    "%g, %g\n"::printf(pos.{x, y} );


    FLAG_WINDOW_RESIZABLE::SetConfigFlags();
    InitWindow( 800, 450, "Hello, raylib!" ) ->} CloseWindow()

    tex_test := LoadTexture( "test.png" ) ->} tex_test::UnloadTexture()

    if !(tex_test::IsTextureValid())
        EXIT_FAILURE::exit()


    GetCurrentMonitor()::GetMonitorRefreshRate()::SetTargetFPS();



    #define vec2(x, y) (Vector2){x, y}

    while !WindowShouldClose()
    {
        delta_time := GetFrameTime()

        wscale :=  GetScreenWidth() / tex_test.width;
        hscale := GetScreenHeight() / tex_test.height;

        float scale = wscale > hscale ? wscale : hscale;
        if (scale < 1) scale = 1;

        positive := vec2( KEY_RIGHT::IsHeld(), KEY_DOWN::IsHeld() )
        negative := vec2( KEY_LEFT ::IsHeld(), KEY_UP  ::IsHeld() )


        input := positive - negative;
        input_norm := input::Vector2Normalize()

        vel := input_norm::Vector2Scale( 150 * scale )

        pos = (pos + vel::Vector2Scale(delta_time))
            ::Vector2Clamp( {0, 0}, {400 * scale, 200 * scale} )

        BeginDrawing() ->} EndDrawing()

        BLACK::ClearBackground()

        scaled_tex_w := (tex_test.width * scale)
        scaled_tex_h := (tex_test.height * scale)

        Vector2 bars = {
            .x = GetScreenWidth() - scaled_tex_w,
            .y = GetScreenHeight() - scaled_tex_h,
        }

        tex_test::DrawTexturePro(
            {0, 0, tex_test.{width, height} },
            {0, 0, scaled_tex_w, scaled_tex_h},
            {-bars.x / 2, -bars.y / 2}, 0, WHITE
        )

        "This is so fucking cool holy"::DrawText( pos.{x, y}, scale * 10, RED )
        b.items::DrawText(20, 20, 40, PINK)

        DrawLineEx( pos, pos + vel, scale, YELLOW )

        DrawFPS(10, 10)

    }


}
