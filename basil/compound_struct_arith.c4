#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

typedef struct {
    float x, y;
} Vector2;

assert_vector (Vector2 v, float expected_x, expected_y, const char *test_name) {
    // Account for potential minor floating-point precision variances
    float delta_x = v.x - expected_x;
    float delta_y = v.y - expected_y;
    if (delta_x < 0) delta_x = -delta_x;
    if (delta_y < 0) delta_y = -delta_y;

    if (delta_x > 0.0001f || delta_y > 0.0001f) {
        printf("Test [%s] FAILED!\n", test_name);
        printf("  Result  : {%g, %g}\n", v.x, v.y);
        printf("  Expected: {%g, %g}\n", expected_x, expected_y);
        exit(1);
    }
    printf("Test [%s] Passed -> {%g, %g}\n", test_name, v.x, v.y);
}

main () int {
    printf("Starting Struct Arithmetic and Compound Assignment Tests...\n\n");

    Vector2 a = {10.0f, 5.0f};
    Vector2 b = {2.0f,  4.0f};

    // 1. Verify Standard Element-Wise Arithmetic Operations
    Vector2 add_res = a + b;
    assert_vector(add_res, 12.0f, 9.0f, "Standard Addition (+)");

    Vector2 sub_res = a - b;
    assert_vector(sub_res, 8.0f, 1.0f, "Standard Subtraction (-)");

    Vector2 mul_res = a * b;
    assert_vector(mul_res, 20.0f, 20.0f, "Standard Multiplication (*)");

    Vector2 div_res = a / b;
    assert_vector(div_res, 5.0f, 1.25f, "Standard Division (/)");

    printf("\n--- Commencing In-Place Compound Assignment Modifiers ---\n\n");

    // Reset baseline state tracking elements
    Vector2 target = {10.0f, 20.0f};
    Vector2 modifier = {5.0f, 2.0f};

    // 2. Verify Compound In-Place Addition Assignments (+=)
    target += modifier; // Should yield: {15.0, 22.0}
    assert_vector(target, 15.0f, 22.0f, "Compound Addition assignment (+=)");

    // 3. Verify Compound In-Place Subtraction Assignments (-=)
    target -= modifier; // Should return back to baseline: {10.0, 20.0}
    assert_vector(target, 10.0f, 20.0f, "Compound Subtraction assignment (-=)");

    // 4. Verify Compound In-Place Multiplication Assignments (*=)
    target *= modifier; // Should yield: {50.0, 40.0}
    assert_vector(target, 50.0f, 40.0f, "Compound Multiplication assignment (*=)");

    // 5. Verify Compound In-Place Division Assignments (/=)
    target /= modifier; // Should return back to: {10.0, 20.0}
    assert_vector(target, 10.0f, 20.0f, "Compound Division assignment (/=)");

    printf("\nAll Element-Wise Struct Arithmetic Integration Tests Cleared Natively!\n");
    return 0;
}
