#include <stdio.h>

foo (size_t s, [] int arr) {
    for i := 0; i < #.arr; ++i {
        "[%d] before: %d\n"::printf(i, arr[i])
        arr[i] += 1;
        "[%d] after: %d\n"::printf(i, arr[i])
    }
}

ptr (^[] int arrptr) {
    for i := 0; i < #.*arrptr; ++i {
        "^[%d] before: %d\n"::printf(i, (*arrptr)[i])
        (*arrptr)[i] += 1;
        "^[%d] after: %d\n"::printf(i, (*arrptr)[i])
    }
}

print ([] int arr) {
    putchar('[');
    for i := 0; i < #.arr; ++i {
        printf("%d", arr[i])
        if (i < #.arr - 1) printf(", ")
    }
    printf("]\n");
}

main () int {
    a := 24;
    c := 24;
    b := 4.5;

    [] int joe = { a, b, c, 10 }

    ^[] int joeptr = &joe;

    printf("%d\n", joe[0] )
    printf("%d\n", joe.items[0] )
    printf("%d\n", (*joeptr)[0] )
    printf("%d\n", joeptr.items[0] )

    printf("%zu\n", #.joe )
    printf("%zu\n", joe.count )
    printf("%zu\n", joeptr.count )
    printf("%zu\n", joeptr->count )
    printf("%zu\n", #.joeptr )
    printf("%zu\n", #.(joeptr) )

    #.joe::foo(joe)
    joe::print()
    ptr(&joe)
    joe::print()
    printf("\033[033m[!] DELIBERATE RUNTIME ARRAY BREACH [!]\033[0m\n")
    index := #.int;
    joe[index] = 5;
}


